    },
    "Memoria por Chat": {
      "ai_memory": [[{ "node": "Agente LM Express", "type": "ai_memory", "index": 0 }]]
    },
    "buscar_paquete": {
      "ai_tool": [[{ "node": "Agente LM Express", "type": "ai_tool", "index": 0 }]]
    }
  },
  "active": false,
